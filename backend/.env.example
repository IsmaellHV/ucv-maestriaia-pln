# Rutas relativas a backend/, resueltas por el motor de inferencia.
FAKENEWS_MODEL_METADATA=results/final_model.json
# cpu funciona sin GPU; también se admiten auto, cuda y cuda:0.
FAKENEWS_DEVICE=cpu
# Vacío: usar el proxy /api de Vite. Para otro origen, indicar orígenes
# exactos separados por comas, sin barra final. No se admite *.
FAKENEWS_CORS_ORIGINS=
